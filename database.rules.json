{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x','y','z'])"
          }
        },
        "events": {
          ".indexOn": ["ts"],
          "$id": {
            ".write": "auth != null && (!data.exists() || data.child('by').val() === auth.uid)",
            ".validate": "newData.child('by').val() === auth.uid"
          }
        }
      }
    }
  }
}
